# Database connection (SQLite for local, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/shrutiblogs?schema=public"

# JWT Secret for Auth
JWT_SECRET="replace-with-a-secure-random-32-character-secret"
JWT_EXPIRES_IN="7d"

# App Info
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Shruti Blogs"

# Server Environment
NODE_ENV="development"
